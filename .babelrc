{
  "presets": [
    "@babel/react",
    [
      "@babel/env",
      {
        "debug": true,
        "modules": false,
        "targets": {
          // The % refers to the global coverage of users from browserslist
          "browsers": [
            ">5%",
            "not ie 11",
            "not op_mini all"
          ]
        }
      }
    ]
  ],
  "env": {
    "test": {
      "presets": [
          "@babel/env",
          {
            "modules": "commonjs"
          }
      ]
    }
  },
  "plugins": [
    "emotion",
    "@babel/plugin-proposal-export-default-from",
    "@babel/plugin-proposal-class-properties"
  ]
}
