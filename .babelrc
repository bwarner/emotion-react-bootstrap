{
  "presets": [
    "react",
    "stage-0",
    [
      "env",
      {
        "debug": true,
        "modules": false,
        "targets": {
          // The % refers to the global coverage of users from browserslist
          "browsers": [
            ">5%",
            "not ie 11",
            "not op_mini all"
          ]
        }

      }
    ]
  ],
  "env": {
    "test": {
      "presets": [
        [
          "env",
          {
            "modules": "commonjs"
          }
        ]
      ]
    }
  },
  "plugins": [
    "emotion",
    ["transform-runtime", {
      "polyfill": false,
      "regenerator": true
    }],
    "babel-plugin-transform-function-bind",
    [
      "babel-plugin-transform-object-rest-spread",
      {
        "useBuiltIns": true
      }
    ]
  ]
}
